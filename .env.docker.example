# Docker Compose variables for the full stack.
#
#   cp .env.docker.example .env
#   docker compose up --build            # prod stack
#   docker compose -f docker-compose.dev.yml up --build   # dev stack (hot reload)
#
# The same file feeds both composes — prod and dev use different container
# names / volumes so they can coexist, but they share the same env schema.

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=products_db
# Host-side port. Change if 5433 is taken on your machine.
POSTGRES_HOST_PORT=5433

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=products_queue
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672

# ─── Apps ────────────────────────────────────────────────────────────────────
PRODUCTS_HOST_PORT=3001
FRONTEND_HOST_PORT=3000

# Browser-facing API URL. The products container is published on the host as
# PRODUCTS_HOST_PORT, so the browser reaches it at http://localhost:<port>.
# Inlined into the frontend bundle at build time — change it and rebuild.
NEXT_PUBLIC_API_URL=http://localhost:3001

LOG_LEVEL=log
