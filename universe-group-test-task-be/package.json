{
  "name": "universe-group-test-task-be",
  "version": "0.0.1",
  "description": "Backend microservices (products + notifications) for Universe Group test task",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build products && nest build notifications",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,libs,scripts}/**/*.ts\" --fix",
    "start:products": "NODE_ENV=development nest start products --watch",
    "start:notifications": "NODE_ENV=development nest start notifications --watch",
    "start:products:stage": "NODE_ENV=stage node dist/apps/products/main",
    "start:notifications:stage": "NODE_ENV=stage node dist/apps/notifications/main",
    "start:products:prod": "NODE_ENV=production node dist/apps/products/main",
    "start:notifications:prod": "NODE_ENV=production node dist/apps/notifications/main",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_ENV=${NODE_ENV:-development} ts-node -r tsconfig-paths/register scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose -f docker-compose.infra.yml up -d",
    "docker:down": "docker compose -f docker-compose.infra.yml down",
    "docker:logs": "docker compose -f docker-compose.infra.yml logs -f",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/platform-express": "^10.0.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^1.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "joi": "^17.13.3",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": ["<rootDir>/apps/", "<rootDir>/libs/"],
    "moduleNameMapper": {
      "^@libs/database(|/.*)$": "<rootDir>/libs/database/src$1",
      "^@libs/rabbitmq(|/.*)$": "<rootDir>/libs/rabbitmq/src$1",
      "^@libs/config(|/.*)$": "<rootDir>/libs/config/src$1"
    }
  }
}
