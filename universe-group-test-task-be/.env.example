# Generic template. Actual values should be set per-environment:
#   .env.development          — local dev (committed)
#   .env.stage                — stage (copy from .env.stage.example, gitignored)
#   .env.production           — prod  (copy from .env.production.example, gitignored)
#   .env.<env>.local          — per-env local overrides (gitignored)
#   .env.local                — shared local overrides (gitignored)
#
# Loading priority (highest first):
#   .env.<NODE_ENV>.local  >  .env.local  >  .env.<NODE_ENV>  >  .env

NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/products_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=products_queue

PRODUCTS_PORT=3001
NOTIFICATIONS_PORT=3002

LOG_LEVEL=log
